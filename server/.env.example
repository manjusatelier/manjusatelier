# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/manjus_atelier

# Auth
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_long_random_secret


# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email / Resend Configuration
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=help@manjusatelier.in
FROM_NAME=Manju's Atelier

# Cashfree Payments Gateway
# Get these from https://merchants.cashfree.com (Developers -> API Keys)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=SANDBOX # 'SANDBOX' for test mode, 'PRODUCTION' for live
CASHFREE_API_VERSION=2023-08-01
